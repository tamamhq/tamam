# Copy to backend/.env. Only the API key is required (or export ANTHROPIC_API_KEY instead); everything else has a working default.
# All settings: docs/guide/configuration.md
TAMAM_ANTHROPIC_API_KEY=

# Appium server (default: a local `appium`)
# TAMAM_APPIUM_SERVER_URL=http://127.0.0.1:4723

# Dashboard, local use only: skip sign-in
# TAMAM_AUTH_DEV_MODE=true   # local mode: no sign-in, answers only this computer

# Dashboard for a team: Postgres + Redis (docker compose up) instead of SQLite + in-process runs
# TAMAM_DATABASE_URL=postgresql+asyncpg://tamam:tamam@localhost:5433/tamam
# TAMAM_REDIS_URL=redis://localhost:6380

# Traces of every step in Laminar (optional)
# TAMAM_LMNR_PROJECT_API_KEY=
